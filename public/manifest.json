{
  "manifest_version": 3,
  "name": "资源嗅探器",
  "version": "1.0.0",
  "description": "嗅探网页中的图片、媒体、文档资源，支持预览、定位、下载",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
